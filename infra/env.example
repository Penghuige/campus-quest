# CampusQuest environment template.
# Copy to the deployment secret store (or a local .env) and fill in real values.
# Never commit real secrets.
#
# Local development defaults (infra/docker-compose.yml):
#   docker compose -f infra/docker-compose.yml up -d
# publishes PostgreSQL on localhost:15432 (app database `campusquest` with user
# `campusquest`, plus integration test database `campusquest_test` with user
# `test` / password `test`), Redis on localhost:6379 (no persistence), and
# MinIO on localhost:9000 (console localhost:9001) with buckets `campusquest`
# and `campusquest-test`. Compose reads POSTGRES_PASSWORD, MINIO_ROOT_USER,
# and MINIO_ROOT_PASSWORD from the environment and falls back to dev-only
# defaults (campusquest-dev / campusquest / campusquest-dev).

# PostgreSQL connection string used by the API, workers, and migrations.
DATABASE_URL=postgresql+asyncpg://campusquest:CHANGE_ME@localhost:15432/campusquest

# Redis connection string for cache, queue, and ranking projection.
REDIS_URL=redis://localhost:6379/0

# S3-compatible object storage endpoint for submission files and previews.
S3_ENDPOINT_URL=http://localhost:9000

# Object storage bucket for submission files and derived previews.
S3_BUCKET=campusquest

# Object storage credentials. Dedicated S3 keys (not AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY) so local MinIO never shadows real AWS credentials;
# compose dev defaults are campusquest / campusquest-dev.
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME

# IANA timezone for business-period semantics (daily quotas, rankings).
BUSINESS_TIMEZONE=Asia/Shanghai

# Deployment profile. "production" makes the API reject insecure development
# defaults at startup; this guards OTP_HMAC_SECRET, TOKEN_SECRET, and
# TOTP_ENCRYPTION_KEY below.
ENVIRONMENT=development

# HMAC key for hashing SMS OTP codes and verified-phone tokens in Redis
# (never stored in plaintext). The application default is a development-only
# sentinel; ENVIRONMENT=production refuses to start until this is set to a
# real deployment secret, because with a known key anyone who can read Redis
# can brute-force the 6-digit code space offline.
OTP_HMAC_SECRET=CHANGE_ME

# HS256 signing key for short-lived access tokens. The application default
# is a development-only sentinel; ENVIRONMENT=production refuses to start
# until this is set (>= 32 characters), because with a known key anyone can
# forge valid access tokens.
TOKEN_SECRET=CHANGE_ME

# Fernet key (32 url-safe base64-encoded bytes, e.g. `python -c "from
# cryptography.fernet import Fernet; print(Fernet.generate_key())"`)
# encrypting staff TOTP secrets at rest. The application default is a
# development-only sentinel; ENVIRONMENT=production refuses to start until
# this is set, because with a known key anyone who can read the database
# can decrypt every stored staff TOTP secret.
TOTP_ENCRYPTION_KEY=CHANGE_ME

# Email-verification token lifetime in hours (spec §5.5); default 24.
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24

# Refresh-rotation replay grace window group (default OFF). Setting a
# window > 0 accepts the section 5.6 contract amendment
# (docs/superpowers/specs/2026-09-30-refresh-grace-amendment.md).
#
#   REFRESH_GRACE_SECONDS          0..60 (hard-validated): how long a
#                                  retired refresh token's replay
#                                  re-issues the live generation
#                                  (stable-successor envelope) instead
#                                  of failing. 0 = strict rotate-once.
#   REFRESH_REPLAY_ENCRYPTION_KEY  required (valid Fernet key) whenever
#                                  the window is on; dedicated on
#                                  purpose — NOT the TOTP key, so
#                                  either secret can rotate
#                                  independently.
REFRESH_GRACE_SECONDS=0
REFRESH_REPLAY_ENCRYPTION_KEY=

# Path-prefix deployment group — set ALL of the group together (or none;
# the defaults describe a root-mounted app behind no prefix).
#
#   EXTERNAL_API_PREFIX   backend: scopes the auth cookies' Path under
#                         the public prefix ("" = /api/v1/auth, "/" csrf)
#   CQ_BASE_PATH          frontend next.config basePath, BUILD and
#                         `next start` runtime both (Next 16 re-evaluates
#                         the config at start)
#   NEXT_PUBLIC_API_BASE  frontend request prefix, BUILD time (inlined);
#                         single application point in lib/apiBase.ts
#   CQ_DEV_API_PROXY      dev-only /api/v1 rewrite target; for a
#                         prefix-mounted production build the reverse
#                         proxy routes /<prefix>/api/* to the backend
#                         instead (strip the prefix), so this stays unset
#
# Example — app mounted at https://host/campus:
#   EXTERNAL_API_PREFIX=/campus
#   CQ_BASE_PATH=/campus
#   NEXT_PUBLIC_API_BASE=/campus
# (browser-direct MinIO also needs its own HTTPS hostname because
# presigned-URL signatures cover the full path and cannot be rewritten;
# its CORS allowlist must include the app's public origin.)
EXTERNAL_API_PREFIX=
