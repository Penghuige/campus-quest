# CampusQuest environment template.
# Copy to the deployment secret store (or a local .env) and fill in real values.
# Never commit real secrets.
#
# Local development defaults (infra/docker-compose.yml):
#   docker compose -f infra/docker-compose.yml up -d
# publishes PostgreSQL on localhost:15432 (app database `campusquest` with user
# `campusquest`, plus integration test database `campusquest_test` with user
# `test` / password `test`), Redis on localhost:6379 (no persistence), and
# MinIO on localhost:9000 (console localhost:9001) with buckets `campusquest`
# and `campusquest-test`. Compose reads POSTGRES_PASSWORD, MINIO_ROOT_USER,
# and MINIO_ROOT_PASSWORD from the environment and falls back to dev-only
# defaults (campusquest-dev / campusquest / campusquest-dev).

# PostgreSQL connection string used by the API, workers, and migrations.
DATABASE_URL=postgresql+asyncpg://campusquest:CHANGE_ME@localhost:15432/campusquest

# Redis connection string for cache, queue, and ranking projection.
REDIS_URL=redis://localhost:6379/0

# S3-compatible object storage endpoint for submission files and previews.
S3_ENDPOINT_URL=http://localhost:9000

# Object storage bucket for submission files and derived previews.
S3_BUCKET=campusquest

# Object storage credentials. Dedicated S3 keys (not AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY) so local MinIO never shadows real AWS credentials;
# compose dev defaults are campusquest / campusquest-dev.
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME

# IANA timezone for business-period semantics (daily quotas, rankings).
BUSINESS_TIMEZONE=Asia/Shanghai

# Deployment profile. "production" makes the API reject insecure development
# defaults at startup; currently this guards OTP_HMAC_SECRET below.
ENVIRONMENT=development

# HMAC key for hashing SMS OTP codes and verified-phone tokens in Redis
# (never stored in plaintext). The application default is a development-only
# sentinel; ENVIRONMENT=production refuses to start until this is set to a
# real deployment secret, because with a known key anyone who can read Redis
# can brute-force the 6-digit code space offline.
OTP_HMAC_SECRET=CHANGE_ME
