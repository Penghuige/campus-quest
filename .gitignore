# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
*.egg-info/

# Coverage data (the ratchet runs leave COVERAGE_FILE variants behind;
# .coverage was committed once by accident — untracked in this change)
.coverage
.coverage.*

# Node
node_modules/
.next/
out/
# Managed by Next.js (regenerated by next dev/build); never edit or track it.
next-env.d.ts
# Incremental TypeScript build info from `tsc --noEmit`.
*.tsbuildinfo
npm-debug.log*

# Playwright e2e run artifacts (reports, traces, videos, results)
test-results/
playwright-report/
blob-report/

# Environment / secrets (one block: rules were duplicated verbatim at
# the file tail; the template lives at backend/env.example, pending the
# owner's rename to .env.example)
.env
.env.*
!.env.example

# Agent worktrees and local session settings
.claude/worktrees/
.claude/settings.local.json

# Editor and OS cruft
.idea/
.vscode/
*.swp
.DS_Store

# agent stream scratch dirs (frontend S4 task workspaces)
.t*scratch/
frontend/e2e/.certs/

# e2e-only MinIO TLS cert (infra/scripts/gen-e2e-minio-cert.sh output)
infra/e2e-certs/
