# CampusQuest backend — local development environment template.
#
# Copy to `.env` (same directory) and adjust. Real environment variables
# always take precedence over this file, so exported vars in CI/production
# are unaffected.
#
# Values below match infra/docker-compose.yml defaults (development only).

# Required deployment configuration
DATABASE_URL=postgresql+asyncpg://campusquest:campusquest-dev@localhost:15432/campusquest
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=campusquest-test
S3_ACCESS_KEY=campusquest
S3_SECRET_KEY=campusquest-dev
BUSINESS_TIMEZONE=Asia/Shanghai

# SMS provider: "logging" (development, delivers nothing) or "aliyun_dypns"
# SMS_PROVIDER=aliyun_dypns
# ALIYUN_SMS_ACCESS_KEY_ID=
# ALIYUN_SMS_ACCESS_KEY_SECRET=
# ALIYUN_SMS_SIGN_NAME=
# ALIYUN_SMS_OTP_TEMPLATE_CODE=

# --- Email provider (batch 4 item 4) --------------------------------------
# EMAIL_PROVIDER=logging|smtp. Production refuses "logging" (fail-closed:
# never record a SENT that was never sent). An "smtp" selection requires
# the four non-empty fields below — startup refuses a half-configured
# provider in EVERY environment (the aliyun_dypns discipline).
EMAIL_PROVIDER=logging
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_USE_TLS=true
