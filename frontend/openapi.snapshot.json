    "/api/v1/auth/staff/invitations/accept": {
      "post": {
        "description": "Trade the single-use invitation token for a pending staff session.\n\nThe returned tokens are a real session confined to finishing TOTP\nsetup (§5.8); management endpoints stay closed until 2FA is confirmed.",
        "operationId": "accept_staff_invitation_api_v1_auth_staff_invitations_accept_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StaffInvitationAcceptRequest"
