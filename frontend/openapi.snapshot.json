              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Accept Staff Invitation"
      }
    },
    "/api/v1/auth/staff/login": {
      "post": {
        "description": "Staff login: verified email + password + TOTP-or-recovery (§5.8).\n\nA correct password without a confirmed TOTP raises the typed setup\nerror, rendered as 403 ``TOTP_SETUP_REQUIRED`` — the client's signal to\nfinish ``/staff/totp/*`` first.",
        "operationId": "staff_login_api_v1_auth_staff_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StaffLoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenPairResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Staff Login"
      }
    },
    "/api/v1/me": {
      "get": {
        "description": "The owner's own account view (spec §40). Read-only: any live session\nmay read its own profile, including a suspended account's.",
        "operationId": "read_me_api_v1_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MePublic"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Read Me"
      }
    },
    "/api/v1/me/claims": {
      "get": {
        "description": "The actor's own claim history, newest first; assignment\nplatform/keyword are visible here because every row is the owner's.\nA Student surface by policy (spec §4.1): staff never own claims, and\nthe 403 pins that boundary instead of serving an empty list.",
        "operationId": "list_my_claims_api_v1_me_claims_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 50,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MyClaimsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List My Claims"
      }
    },
