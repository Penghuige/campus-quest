      "TokenPairResponse": {
        "description": "One issued session (spec §5.6) — cookie-only refresh delivery.\n\nThe long-lived refresh token NEVER rides in the body:\nit travels exclusively in the HttpOnly refresh cookie the response\nsets, so a JSON body (loggers, proxies, XSS-readable storage) can\nnever leak a live refresh credential. The body's ``access_token`` is\nthe short-lived JWT — including the ``must_setup_totp`` pending staff\nsession's, which is deliberate: it is not the long-lived credential\nand confined-by-construction to the TOTP setup endpoints.\n``csrf_token`` mirrors the non-HttpOnly CSRF cookie so scripted\nclients can echo it without parsing ``Set-Cookie``.",
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          },
          "token_type": {
            "default": "bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "csrf_token"
        ],
        "title": "TokenPairResponse",
        "type": "object"
      },
