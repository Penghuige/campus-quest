  "components": {
    "schemas": {
      "ChallengeResponse": {
        "description": "Request-side view of an OTP challenge (never the code, §33.2).",
        "properties": {
          "challenge_id": {
            "format": "uuid",
            "title": "Challenge Id",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          }
        },
        "required": [
          "challenge_id",
          "expires_at"
        ],
        "title": "ChallengeResponse",
        "type": "object"
      },
      "EmailBindRequest": {
        "description": "Bind (or re-bind) an email and send its verification token (§5.5).",
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "EmailBindRequest",
        "type": "object"
      },
      "EmailChallengeResponse": {
        "description": "Request-side view of one email-verification cycle (token-less).",
        "properties": {
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          }
        },
        "required": [
          "expires_at"
        ],
        "title": "EmailChallengeResponse",
        "type": "object"
      },
      "EmailUnbindRequest": {
        "description": "Unbind the email after re-authentication (spec §5.5).",
        "properties": {
          "password": {
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "password"
        ],
        "title": "EmailUnbindRequest",
        "type": "object"
      },
      "EmailVerifyRequest": {
        "description": "Confirm an email binding with the token from the message (§5.5).",
        "properties": {
          "token": {
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "title": "EmailVerifyRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LoginRequest": {
        "description": "Student login: student number + password (spec §5.6).",
        "properties": {
          "password": {
            "title": "Password",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "LogoutRequest": {
        "description": "Logout one session; cookie-carried tokens need no body.",
        "properties": {
          "refresh_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Refresh Token"
          }
        },
        "title": "LogoutRequest",
        "type": "object"
      },
      "MePublic": {
        "description": "The owner's own account page (spec §40): contacts included.\n\nPhone and email are the owner's own data (they typed them); the DTO\nstill enumerates fields explicitly, so the Argon2id verifier and any\nother internal column stay unrepresentable.",
        "properties": {
          "email_normalized": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email Normalized"
          },
          "email_verified_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email Verified At"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "nickname": {
            "title": "Nickname",
            "type": "string"
          },
          "phone_e164": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone E164"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "status": {
            "$ref": "#/components/schemas/UserStatus"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "nickname",
          "role",
          "status",
          "phone_e164",
          "email_normalized",
          "email_verified_at"
        ],
        "title": "MePublic",
        "type": "object"
      },
      "MyClaimResponse": {
        "description": "A /me/claims item: the claim view plus the task's title (the list is\ncross-task, so the card context travels with the claim).",
        "properties": {
          "base_reward_points_snapshot": {
            "title": "Base Reward Points Snapshot",
            "type": "integer"
          },
          "claim_id": {
            "format": "uuid",
            "title": "Claim Id",
