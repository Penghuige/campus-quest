          }
        },
        "summary": "Confirm Password Reset"
      }
    },
    "/api/v1/auth/phone/challenges": {
      "post": {
        "description": "Issue a REGISTER-purpose OTP challenge (spec §5.4, §33.2).\n\nThe purpose is fixed server-side: a public endpoint must never mint\nproofs for password reset or phone change.",
        "operationId": "request_phone_challenge_api_v1_auth_phone_challenges_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PhoneChallengeRequest"
              }
            }
          },
          "required": true
