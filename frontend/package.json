{
  "name": "campusquest-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "check:css": "node scripts/check-css-integrity.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test src/__tests__/*.test.ts",
    "test": "npm run test:unit",
    "api:types": "openapi-typescript \"${OPENAPI_URL:-http://localhost:8000/openapi.json}\" -o src/lib/api/schema.d.ts",
    "api:types:snapshot": "openapi-typescript openapi.snapshot.json -o src/lib/api/schema.d.ts",
    "test:e2e": "playwright test",
    "test:e2e:visual": "playwright test visual-regression.spec.ts ${CQ_VISUAL_UPDATE:+--update-snapshots}",
    "test:coverage": "tsx --test --experimental-test-coverage src/__tests__/*.test.ts",
    "coverage:ratchet": "node scripts/check-coverage-ratchet.mjs",
    "coverage:update": "node scripts/check-coverage-ratchet.mjs --update",
    "audit:gate": "node scripts/check-audit.mjs",
    "test:e2e:a11y": "playwright test accessibility.spec.ts"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-slot": "^1.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "clsx": "^2.1.1",
    "next": "^16.3.5",
    "postcss": "^8.5.29",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
