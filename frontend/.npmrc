# openapi-typescript@7 still declares a typescript@^5 peer range while this
# project pins TypeScript 6 (the generated schema.d.ts is consumed by our
# own tsc, which type-checks it on every `npm run typecheck`). Until the
# upstream peer range catches up, installs resolve with legacy peer
# semantics; `npm ci` enforces peers otherwise and would fail.
legacy-peer-deps=true
